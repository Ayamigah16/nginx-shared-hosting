# ================================================================================
# Git Ignore File for Nginx Virtual Hosts Project
# ================================================================================

# Log Files
logs/*.log
logs/**/*.log

# Backup Files
backups/*
!backups/README.md

# Temporary Files
*.tmp
*.temp
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# IDE/Editor Files
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# Script Backup Files
scripts/*.backup
scripts/*-old.sh
scripts/*-new.sh
scripts/*.bak

# Configuration Overrides (keep config.sh template)
# Uncomment if you don't want to track your actual config
# config.sh

# SSL Certificates (never commit these!)
*.pem
*.key
*.crt
*.csr

# Archive Files
*.tar.gz
*.zip
*.rar
*.7z

# Node modules (if using any JS tools)
node_modules/

# Python cache (if using any Python tools)
__pycache__/
*.pyc
*.pyo

# Environment Files
.env
.env.local
.env.*.local

# Test Output
test-results/
coverage/
